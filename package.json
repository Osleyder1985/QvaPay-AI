{
  "name": "qvapay-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:docs-language": "node scripts/check-documentation-language.mjs",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "check:code-docs": "node scripts/check-code-documentation.mjs",
    "test:browser": "playwright test",
    "format:fix": "prettier --write .",
    "check:prettier-exclusions": "node scripts/check-prettier-exclusions.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.8",
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "prettier": "3.9.9",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.44.0",
    "wrangler": "4.146.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0"
  }
}
