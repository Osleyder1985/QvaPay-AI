{
  "name": "qvapay-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --write \"src/infrastructure/qvapay/qvapay-account-client.ts\" && git diff -- src/infrastructure/qvapay/qvapay-account-client.ts && git diff --exit-code -- src/infrastructure/qvapay/qvapay-account-client.ts",
    "format": "prettier --write .",
    "check:docs-language": "node scripts/check-documentation-language.mjs",
    "cf:types": "wrangler types",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "check:code-docs": "node scripts/check-code-documentation.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "prettier": "3.9.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.44.0",
    "wrangler": "4.146.0"
  }
}
